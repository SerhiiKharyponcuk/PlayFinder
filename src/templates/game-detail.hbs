<article class="game-detail" aria-labelledby="gameTitle">
  <div class="game-detail__media">
    <div class="game-detail__cover-wrap">
      <img class="game-detail__cover" src="{{image}}" alt="{{title}}" width="720" height="800">
      {{#if release.isUpcoming}}<span class="game-detail__badge"><i class="fa-regular fa-clock" aria-hidden="true"></i> Ще не вийшла</span>{{/if}}
    </div>
    <section class="game-detail__facts" aria-labelledby="gameFactsTitle">
      <h2 class="game-detail__section-title" id="gameFactsTitle">Про гру</h2>
      <dl class="game-detail__facts-list">
        <div><dt>{{release.dateHeading}}</dt><dd>{{#if release.dateTime}}<time datetime="{{release.dateTime}}">{{release.dateLabel}}</time>{{else}}{{release.dateLabel}}{{/if}}</dd></div>
        {{#if developerLabel}}<div><dt>Розробник</dt><dd>{{developerLabel}}</dd></div>{{/if}}
        {{#if publisherLabel}}<div><dt>Видавець</dt><dd>{{publisherLabel}}</dd></div>{{/if}}
        {{#if genreLabel}}<div><dt>Жанри</dt><dd>{{genreLabel}}</dd></div>{{/if}}
        <div><dt>Статус</dt><dd>{{release.label}}</dd></div>
      </dl>
    </section>
  </div>
  <div class="game-detail__content">
    <p class="game-detail__eyebrow">Відкривай нові світи</p>
    <h1 class="game-detail__title" id="gameTitle">{{title}}</h1>
    <div class="game-detail__platforms" aria-label="Платформи гри">
      {{#each platformIcons}}<span class="game-detail__platform" role="img" aria-label="{{label}}" title="{{label}}"><i class="{{icon}}" aria-hidden="true"></i></span>{{/each}}
    </div>
    {{#if genres}}<ul class="game-detail__genres" aria-label="Жанри">{{#each genres}}<li class="game-detail__genre">{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if hasRating}}<p class="game-detail__rating"><i class="fa-solid fa-star" aria-hidden="true"></i> <strong>{{ratingLabel}}<span>/5</span></strong> <span class="game-detail__reviews">{{ratingsCount}} оцінок у RAWG</span></p>{{/if}}
    {{#if release.isUpcoming}}
      <div class="game-detail__release-notice" role="status"><i class="fa-regular fa-calendar" aria-hidden="true"></i><div><strong>Гра ще не вийшла</strong><span>{{release.dateHeading}}: {{release.dateLabel}}</span></div></div>
    {{/if}}
    <p class="game-detail__description">{{description}}</p>
    {{#if fullDescription}}<details class="game-detail__description-more"><summary>Читати повний опис <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><p class="game-detail__description">{{fullDescription}}</p></details>{{/if}}
    <section class="game-detail__prices" aria-labelledby="gamePricesTitle">
      <div class="game-detail__price-heading">
        <h2 class="game-detail__section-title" id="gamePricesTitle">{{#if release.isUpcoming}}Пропозиції до релізу · PC{{else}}Ціни для PC{{/if}}</h2>
        {{#if priceEditionLabel}}<span class="game-detail__edition" title="{{priceProductTitle}}">{{priceEditionLabel}}</span>{{/if}}
      </div>
      {{#if hasPrice}}<p class="game-detail__minimum">Від <strong>{{formattedPrice}}</strong><span>{{storeCount}} {{storesLabel}}</span></p>{{/if}}
      {{#if priceStale}}<p class="game-detail__price-note">Збережена ціна · уточни в магазині</p>{{/if}}
      {{#if offers}}
        <ul class="game-detail__offers">
          {{#each offers}}<li class="game-detail__offer{{#if best}} game-detail__offer--best{{/if}}">
            <span class="game-detail__store"><i class="fa-solid fa-store" aria-hidden="true"></i>{{store}}{{#if best}}<span class="game-detail__best">Найкраща ціна</span>{{/if}}</span>
            <strong class="game-detail__offer-price">{{formattedPrice}}</strong>
            {{#if url}}<a class="game-detail__offer-link" href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="Перейти до {{store}}">Перейти <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{/if}}
          </li>{{/each}}
        </ul>
      {{else}}<p class="game-detail__empty-price">{{priceMessage}}</p>{{/if}}
      <p class="game-detail__price-caption">Пропозиції CheapShark у USD для PC. Ціни на інші платформи не враховані.</p>
    </section>
    <div class="game-detail__actions">
      <button class="game-detail__action game-detail__action--favorite" type="button" data-favorite-id="{{id}}" aria-label="Додати в обране" aria-pressed="false"><i class="fa-regular fa-heart" aria-hidden="true"></i> До обраного</button>
      {{#if website}}<a class="game-detail__action" href="{{website}}" target="_blank" rel="noopener noreferrer">Сайт гри <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{/if}}
    </div>
  </div>
</article>
