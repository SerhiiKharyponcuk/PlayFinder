<article class="game-detail" aria-labelledby="gameTitle">
  <div class="game-detail__media">
    <div class="game-detail__cover-wrap">
      <img class="game-detail__cover" src="{{image}}" alt="{{title}}" width="720" height="800" decoding="async">
      {{#if release.isUpcoming}}<span class="game-detail__badge" data-i18n><i class="fa-regular fa-clock" aria-hidden="true"></i> Ще не вийшла</span>{{/if}}
    </div>
    <section class="game-detail__facts" aria-labelledby="gameFactsTitle">
      <h2 class="game-detail__section-title" id="gameFactsTitle" data-i18n>Про гру</h2>
      <dl class="game-detail__facts-list">
        <div><dt data-i18n>{{release.dateHeading}}</dt><dd data-i18n>{{#if release.dateTime}}<time datetime="{{release.dateTime}}" data-i18n-date="{{release.dateTime}}">{{release.dateLabel}}</time>{{else}}{{release.dateLabel}}{{/if}}</dd></div>
        {{#if developerLabel}}<div><dt data-i18n>Розробник</dt><dd>{{developerLabel}}</dd></div>{{/if}}
        {{#if publisherLabel}}<div><dt data-i18n>Видавець</dt><dd>{{publisherLabel}}</dd></div>{{/if}}
        {{#if genreLabel}}<div><dt data-i18n>Жанри</dt><dd>{{genreLabel}}</dd></div>{{/if}}
        <div><dt data-i18n>Статус</dt><dd data-i18n>{{release.label}}</dd></div>
      </dl>
    </section>
  </div>
  <div class="game-detail__content">
    <p class="game-detail__eyebrow" data-i18n>Відкривай нові світи</p>
    <h1 class="game-detail__title" id="gameTitle">{{title}}</h1>
    <div class="game-detail__platforms" aria-label="Платформи гри" data-i18n-attrs="aria-label">
      {{#each platformIcons}}<span class="game-detail__platform" role="img" aria-label="{{label}}" title="{{label}}"><i class="{{icon}}" aria-hidden="true"></i></span>{{/each}}
    </div>
    {{#if genres}}<ul class="game-detail__genres" aria-label="Жанри" data-i18n-attrs="aria-label">{{#each genres}}<li class="game-detail__genre">{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if hasRating}}<p class="game-detail__rating"><i class="fa-solid fa-star" aria-hidden="true"></i> <strong>{{ratingLabel}}<span>/5</span></strong> <span class="game-detail__reviews" data-i18n>{{ratingsCount}} оцінок у RAWG</span></p>{{/if}}
    {{#if release.isUpcoming}}
      <div class="game-detail__release-notice" role="status"><i class="fa-regular fa-calendar" aria-hidden="true"></i><div><strong data-i18n>Гра ще не вийшла</strong><p><span data-i18n>{{release.dateHeading}}</span>: <time data-i18n data-i18n-date="{{release.dateTime}}">{{release.dateLabel}}</time></p></div></div>
    {{/if}}
    <p class="game-detail__description" {{#if descriptionIsMissing}}data-i18n{{/if}}>{{description}}</p>
    {{#if fullDescription}}<details class="game-detail__description-more"><summary data-i18n>Читати повний опис <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><p class="game-detail__description">{{fullDescription}}</p></details>{{/if}}
    <section class="game-detail__prices" aria-labelledby="gamePricesTitle" aria-busy="{{#if priceLoading}}true{{else}}false{{/if}}">
      <div class="game-detail__price-heading">
        <h2 class="game-detail__section-title" id="gamePricesTitle" data-i18n>{{#if release.isUpcoming}}Пропозиції до релізу · PC{{else}}Ціни для PC{{/if}}</h2>
        {{#if priceEditionLabel}}<span class="game-detail__edition" title="{{priceProductTitle}}">{{priceEditionLabel}}</span>{{/if}}
      </div>
      {{#if priceLoading}}<p class="game-detail__empty-price" data-i18n><span class="loading-spinner" aria-hidden="true"></span> Шукаємо актуальні пропозиції…</p>{{else}}
      {{#if hasPrice}}<p class="game-detail__minimum" data-i18n>Від <strong data-i18n-price="{{price}}" data-currency="USD">{{formattedPrice}}</strong><span data-i18n>{{storeCount}} {{storesLabel}}</span></p>{{/if}}
      {{#if priceStale}}<p class="game-detail__price-note" data-i18n>Збережена ціна · уточни в магазині</p>{{/if}}
      {{#if offers}}
        <ul class="game-detail__offers">
          {{#each offers}}<li class="game-detail__offer{{#if best}} game-detail__offer--best{{/if}}">
            <span class="game-detail__store"><i class="fa-solid fa-store" aria-hidden="true"></i>{{store}}{{#if best}}<span class="game-detail__best" data-i18n>Найкраща ціна</span>{{/if}}</span>
            <strong class="game-detail__offer-price" data-i18n-price="{{price}}" data-currency="{{currency}}">{{formattedPrice}}</strong>
            {{#if url}}<a class="game-detail__offer-link" href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="Перейти до {{store}}" data-i18n data-i18n-attrs="aria-label">Перейти <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{/if}}
          </li>{{/each}}
        </ul>
      {{else}}<p class="game-detail__empty-price" data-i18n>{{priceMessage}}</p>{{/if}}
      {{/if}}
      <p class="game-detail__price-caption" data-i18n>Пропозиції CheapShark у USD для PC. Ціни на інші платформи не враховані.</p>
    </section>
    <div class="game-detail__actions">

      <button class="game-detail__action game-detail__action--favorite" type="button" data-favorite-id="{{id}}" aria-label="Додати в обране" aria-pressed="false" data-i18n data-i18n-attrs="aria-label"><i class="fa-regular fa-heart" aria-hidden="true"></i> До обраного</button>
      {{#if website}}<a class="game-detail__action" href="{{website}}" target="_blank" rel="noopener noreferrer" data-i18n>Сайт гри <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>{{/if}}
    </div>
  </div>
</article>
