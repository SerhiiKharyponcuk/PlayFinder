<article class="game-card" data-game-id="{{id}}">
  <div class="game-card__image">
    <a class="game-card__image-link" href="{{detailsUrl}}"><img class="game-card__cover" src="{{image}}" alt="{{title}}" width="320" height="240" loading="lazy" decoding="async"></a>
    {{#if release.isUpcoming}}<span class="game-card__release-badge" data-i18n><i class="fa-regular fa-clock" aria-hidden="true"></i> Ще не вийшла</span>{{/if}}
    <button class="game-card__favorite" type="button" data-favorite-id="{{id}}" aria-label="Додати в обране" aria-pressed="false" data-i18n-attrs="aria-label"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
  </div>
  <div class="game-card__body">
    <a class="game-card__title" href="{{detailsUrl}}">{{title}}</a>
    <div class="game-card__platforms" aria-label="Платформи" data-i18n-attrs="aria-label">{{#each platformIcons}}<span class="game-card__platform" title="{{label}}" role="img" aria-label="{{label}}"><i class="{{icon}}" aria-hidden="true"></i></span>{{/each}}</div>
    {{#if release.isUpcoming}}<p class="game-card__release-date" data-i18n data-i18n-date="{{release.dateTime}}">{{release.dateLabel}}</p>{{/if}}
    <div class="game-card__pricing" aria-busy="{{#if priceLoading}}true{{else}}false{{/if}}">
    {{#if priceLoading}}
      <p class="game-card__price game-card__price--loading" data-i18n><span class="loading-spinner" aria-hidden="true"></span> Шукаємо ціну…</p>
      <p class="game-card__stores" data-i18n>Пропозиції для PC</p>
    {{else}}
    {{#if hasPrice}}
      {{#if release.isUpcoming}}<p class="game-card__availability" data-i18n>Пропозиція до релізу</p>{{/if}}
      <p class="game-card__price" title="{{priceCheckedLabel}}" data-i18n-checked="{{priceUpdatedAt}}"><span class="game-card__price-text" data-i18n>Від</span> <strong class="game-card__price-value" data-i18n-price="{{price}}" data-currency="USD">{{formattedPrice}}</strong></p>
      <p class="game-card__stores" data-i18n>{{storeCount}} {{storesLabel}} · PC</p>
      {{#if priceEditionLabel}}<p class="game-card__edition" title="{{priceProductTitle}}">{{priceEditionLabel}}</p>{{/if}}
      {{#if priceStale}}<p class="game-card__price-note" title="{{priceCheckedLabel}}" data-i18n-checked="{{priceUpdatedAt}}" data-i18n>Збережена ціна · уточни в магазині</p>{{/if}}
    {{else}}
      <p class="game-card__price game-card__price--unavailable" title="{{priceError}}" data-i18n data-i18n-attrs="title">{{priceMessage}}</p>
      <p class="game-card__stores" data-i18n>Пропозиції для PC</p>
    {{/if}}
    {{/if}}
    </div>
  </div>
</article>
