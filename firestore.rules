rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Користувач читає/змінює тільки своє обране. Решта документів закрита.
    match /users/{userId}/favorites/{gameId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && gameId.matches('[0-9]+')
        && request.resource.data.keys().hasOnly(['rawgId', 'savedAt'])
        && request.resource.data.rawgId == gameId
        && request.resource.data.savedAt == request.time;
    }
  }
}
