# Скопіюй у .env.local. Тут лише приклад: справжні значення не коміть.
# RAWG → https://rawg.io/apidocs → Get API Key
VITE_RAWG_API_KEY=

# Firebase Console → Project settings → Your apps → Web app → SDK config
# Це конфіг клієнтського Web App, НЕ service account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# CheapShark не потребує ключа.
